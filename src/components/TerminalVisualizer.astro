---
interface Node {
  id: string;
  label?: string;
  group: number;
  size: number;
  href?: string;
}

interface Link {
  source: string;
  target: string;
}

interface Props {
  nodes: Node[];
  links: Link[];
}

const { nodes, links } = Astro.props;
const graphData = JSON.stringify({ nodes, links });
---

<div
  id="visualizer-container"
  class="w-full bg-surface border border-border rounded-md overflow-hidden shadow-md transition-shadow duration-300 hover:shadow-lg"
  data-graph={graphData}
>
  <svg id="visualizer" class="block w-full min-h-[400px] sm:min-h-[520px]"></svg>
</div>

<script>
  import { select } from "d3-selection";
  import { forceSimulation, forceLink, forceManyBody, forceCenter, forceCollide } from "d3-force";
  import { drag } from "d3-drag";
  import { zoom, zoomIdentity } from "d3-zoom";

  function initVisualizer() {
    const container = document.getElementById("visualizer-container");
    const svgElement = document.getElementById("visualizer");
    if (!container || !svgElement) return;

    const raw = container.dataset.graph;
    if (!raw) return;
    const { nodes, links } = JSON.parse(raw);

    svgElement.innerHTML = "";

    const svg = select(svgElement);
    const width = container.clientWidth || 720;
    const height = 540;

    svg.attr("width", width).attr("height", height);

    // Inner group — zoom/pan transforms this
    const g = svg.append("g");

    let currentTransform = zoomIdentity;

    const zoomBehavior = zoom()
      .scaleExtent([0.3, 3])
      .on("zoom", (event) => {
        currentTransform = event.transform;
        g.attr("transform", event.transform);
      });

    svg.call(zoomBehavior).on("dblclick.zoom", null); // disable double-click zoom

    const simulation = forceSimulation(nodes)
      .force(
        "link",
        forceLink(links)
          .id((d) => d.id)
          .distance(90)
      )
      .force("charge", forceManyBody().strength(-320))
      .force("center", forceCenter(width / 2, height / 2))
      .force(
        "collide",
        forceCollide().radius((d) => d.size + 18)
      );

    const link = g
      .append("g")
      .selectAll("line")
      .data(links)
      .enter()
      .append("line")
      .attr("stroke-width", 1.5)
      .attr("stroke", (d) => {
        const g = d.source.group ?? 1;
        if (g === 1) return "rgba(247,111,83,0.4)";
        if (g === 2) return "rgba(247,111,83,0.2)";
        return "rgba(255,255,255,0.07)";
      });

    const node = g
      .append("g")
      .selectAll("g")
      .data(nodes)
      .enter()
      .append("g")
      .style("cursor", (d) => (d.href ? "pointer" : "grab"))
      .on("click", (event, d) => {
        if (d.href && !event.defaultPrevented) window.location.href = d.href;
      })
      .call(
        drag()
          .on("start", (event, d) => {
            if (!event.active) simulation.alphaTarget(0.3).restart();
            d.fx = d.x;
            d.fy = d.y;
          })
          .on("drag", (event, d) => {
            const [x, y] = currentTransform.invert([
              event.sourceEvent.offsetX,
              event.sourceEvent.offsetY,
            ]);
            d.fx = x;
            d.fy = y;
          })
          .on("end", (event, d) => {
            if (!event.active) simulation.alphaTarget(0);
            d.fx = null;
            d.fy = null;
          })
      );

    node
      .append("circle")
      .attr("r", (d) => d.size)
      .attr("fill", (d) => {
        if (d.group === 1) return "#f76f53";
        if (d.group === 2) return "#1c1b22";
        if (d.group === 3) return "#232229";
        return "#111113";
      })
      .attr("stroke", (d) => {
        if (d.group === 1) return "#f76f53";
        if (d.group === 2) return "#f76f53";
        if (d.group === 3) return "rgba(255,255,255,0.14)";
        return "rgba(255,255,255,0.08)";
      })
      .attr("stroke-width", 1.5);

    node
      .append("text")
      .text((d) => d.label ?? d.id)
      .attr("x", (d) => d.size + 5)
      .attr("y", 4)
      .attr("fill", (d) => (d.group <= 2 ? "#f0eff4" : "#9e9da8"))
      .attr("font-size", (d) => (d.group === 1 ? "13px" : d.group === 2 ? "11px" : "10px"))
      .attr("font-family", "Rubik, sans-serif")
      .attr("font-weight", (d) => (d.group <= 2 ? "500" : "400"))
      .style("pointer-events", "none");

    simulation.on("tick", () => {
      link
        .attr("x1", (d) => d.source.x)
        .attr("y1", (d) => d.source.y)
        .attr("x2", (d) => d.target.x)
        .attr("y2", (d) => d.target.y);
      node.attr("transform", (d) => `translate(${d.x},${d.y})`);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initVisualizer);
  } else {
    initVisualizer();
  }

  window.addEventListener("resize", () => {
    const container = document.getElementById("visualizer-container");
    const svg = document.getElementById("visualizer");
    if (container && svg) svg.setAttribute("width", container.clientWidth.toString());
  });

  document.addEventListener("astro:page-load", initVisualizer);
</script>
