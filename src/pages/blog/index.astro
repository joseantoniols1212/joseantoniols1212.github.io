---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="pt-8 pb-4">
    <h1 class="text-[1.6rem] sm:text-[2rem] font-semibold mb-2 underline decoration-accent">
      Blog
    </h1>
    <p class="text-muted">Thoughts on computer science, software, math, and more.</p>
  </section>

  <section class="my-0">
    <ul class="list-none p-0 -mx-4 sm:-mx-6">
      {
        posts.map((post) => (
          <li class="border-b border-border first:border-t transition-colors duration-200 hover:bg-surface group">
            <a
              href={`/blog/${post.id}/`}
              class="flex items-center gap-4 px-4 sm:px-6 py-4 sm:py-5 text-foreground no-underline opacity-100 hover:opacity-100"
            >
              {(post.data.thumbnail ?? post.data.heroImage) ? (
                <div class="shrink-0 w-16 h-16 sm:w-20 sm:h-20 rounded-sm overflow-hidden">
                  <Image
                    src={post.data.thumbnail ?? post.data.heroImage!}
                    alt={post.data.title}
                    class="w-full h-full object-cover"
                    width={80}
                    height={80}
                  />
                </div>
              ) : (
                <div class="shrink-0 w-16 h-16 sm:w-20 sm:h-20 rounded-sm bg-surface border border-border" />
              )}
              <div class="min-w-0">
                <p class="font-mono text-xs text-muted mb-1 m-0">
                  <FormattedDate date={post.data.pubDate} />
                </p>
                <h4
                  class="text-lg font-medium text-foreground mb-1 transition-colors duration-200 group-hover:text-accent"
                  style="margin:0 0 0.25rem;"
                >
                  {post.data.title}
                </h4>
                <p class="text-sm text-muted m-0">{post.data.description}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
