---
import { getCollection, render } from "astro:content";

const jobs = (await getCollection("experience")).sort((a, b) => a.data.order - b.data.order);
const studies = (await getCollection("studies")).sort((a, b) => a.data.order - b.data.order);

function formatPeriod(start: Date, end?: Date) {
  const fmt = (d: Date) => d.toLocaleDateString("en-US", { month: "short", year: "numeric" });
  return end ? `${fmt(start)} – ${fmt(end)}` : `${fmt(start)} – Present`;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>CV — José Antonio Luque Salguero</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html,
      body {
        background: #fff;
        color: #111;
        font-family: "Rubik", sans-serif;
        font-size: 11pt;
        line-height: 1.5;
      }

      .page {
        max-width: 780px;
        margin: 0 auto;
        padding: 2.5rem 2.5rem;
      }

      /* Header */
      .cv-header {
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #111;
      }

      .cv-header h1 {
        font-size: 1.8rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        margin-bottom: 0.25rem;
      }

      .cv-header .contact {
        font-size: 0.8rem;
        color: #555;
        display: flex;
        gap: 1.2rem;
        flex-wrap: wrap;
      }

      /* Sections */
      section {
        margin-bottom: 1.4rem;
      }

      section h2 {
        font-size: 0.65rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: #888;
        border-bottom: 1px solid #ddd;
        padding-bottom: 3px;
        margin-bottom: 0.75rem;
      }

      /* Timeline entries */
      .entry {
        display: grid;
        grid-template-columns: 1fr auto;
        column-gap: 1rem;
        margin-bottom: 0.9rem;
        page-break-inside: avoid;
      }

      .entry:last-child {
        margin-bottom: 0;
      }

      .entry-title {
        font-size: 0.95rem;
        font-weight: 600;
      }

      .entry-sub {
        font-size: 0.82rem;
        color: #111;
        margin-top: 1px;
      }

      .entry-meta {
        text-align: right;
        font-size: 0.75rem;
        color: #777;
        white-space: nowrap;
      }

      .entry-meta .location {
        display: block;
        font-size: 0.72rem;
        color: #aaa;
      }

      .entry-body {
        grid-column: 1 / -1;
        font-size: 0.82rem;
        color: #444;
        margin-top: 0.2rem;
        line-height: 1.55;
      }

      /* Skills grid */
      .skills-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.3rem 1.5rem;
        font-size: 0.82rem;
        color: #444;
      }

      .skills-grid strong {
        color: #111;
      }

      @media print {
        @page {
          margin: 1.5cm 1.8cm;
          size: A4;
        }

        .page {
          padding: 0;
        }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <!-- Header -->
      <header class="cv-header">
        <h1>José Antonio Luque Salguero</h1>
        <div class="contact">
          <span>Málaga, Spain</span>
          <span>joseantonioluquesalguero1212@gmail.com</span>
          <a href="https://www.jaluque.es">jaluque.es</a>
        </div>
      </header>

      <!-- Experience -->
      <section>
        <h2>Experience</h2>
        {
          jobs.map(async (job) => {
            const { Content } = await render(job);
            return (
              <div class="entry">
                <div>
                  <div class="entry-title">{job.data.role}</div>
                  <div class="entry-sub">
                    {job.data.url ? (
                      <a href={job.data.url} style="color:#111;text-decoration:none;">
                        {job.data.company}
                      </a>
                    ) : (
                      job.data.company
                    )}
                  </div>
                </div>
                <div class="entry-meta">
                  {formatPeriod(job.data.startDate, job.data.endDate)}
                  {job.data.location && <span class="location">{job.data.location}</span>}
                </div>
                <div class="entry-body">
                  <Content />
                </div>
              </div>
            );
          })
        }
      </section>

      <!-- Studies -->
      <section>
        <h2>Education</h2>
        {
          studies.map(async (study) => {
            const { Content } = await render(study);
            return (
              <div class="entry">
                <div>
                  <div class="entry-title">
                    {study.data.degree}
                    {study.data.field ? ` in ${study.data.field}` : ""}
                  </div>
                  <div class="entry-sub">{study.data.institution}</div>
                </div>
                <div class="entry-meta">
                  {formatPeriod(study.data.startDate, study.data.endDate)}
                  {study.data.location && <span class="location">{study.data.location}</span>}
                </div>
                <div class="entry-body">
                  <Content />
                </div>
              </div>
            );
          })
        }
      </section>

      <!-- Skills -->
      <section>
        <h2>Skills</h2>
        <div class="skills-grid">
          <div><strong>Languages:</strong> Python, C, Java, JavaScript, TypeScript</div>
          <div><strong>Frontend:</strong> React, Angular, Tailwind, HTML/CSS</div>
          <div><strong>Backend:</strong> Spring Boot, FastAPI, REST APIs, Kafka</div>
          <div><strong>Databases:</strong> Oracle, PostgreSQL, MongoDB, DynamoDB</div>
          <div><strong>DevOps:</strong> Docker, Kubernetes, GCP, AWS, GitHub Actions</div>
          <div><strong>ML / Scientific:</strong> PyTorch, Jupyter, LaTeX, Matlab</div>
        </div>
      </section>

      <!-- Languages -->
      <section>
        <h2>Languages</h2>
        <div class="skills-grid">
          <div><strong>Spanish:</strong> Native</div>
          <div>
            <strong>English:</strong> B2/C1 (Listening &amp; Reading C1, Speaking &amp; Writing B2)
          </div>
        </div>
      </section>
    </div>
  </body>
</html>
